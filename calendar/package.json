{
  "name": "plancia-calendar",
  "version": "0.3.0",
  "description": "Calendars for Vue 3 from a YAML source: month, week, day and list views, an editor of events and of their repeats, the format read and written as gosidian's server reads it. The days of the repeats come from the host.",
  "type": "module",
  "license": "MIT",
  "author": "Daniele Chiappa",
  "homepage": "https://github.com/daniele-chiappa/plancia/tree/main/calendar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniele-chiappa/plancia.git",
    "directory": "calendar"
  },
  "bugs": {
    "url": "https://github.com/daniele-chiappa/plancia/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "calendar",
    "agenda",
    "events",
    "recurrence",
    "yaml"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/plancia-calendar.js",
  "module": "./dist/plancia-calendar.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/plancia-calendar.js"
    },
    "./style.css": "./dist/plancia-calendar.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config vite.playground.config.ts",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "@microsoft/api-extractor": {
      "minimatch": "^11.0.1"
    },
    "editorconfig": {
      "minimatch": "^11.0.1"
    },
    "glob": {
      "minimatch": "^11.0.1"
    }
  }
}
