{
  "name": "plancia",
  "version": "0.3.0",
  "description": "Tiling window-manager component (niri-style) for Vue 3 — a scrollable strip of resizable, content-agnostic windows, plus sidebar, layout, dialog and config building blocks.",
  "type": "module",
  "license": "MIT",
  "author": "Daniele Chiappa",
  "homepage": "https://github.com/daniele-chiappa/plancia#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniele-chiappa/plancia.git"
  },
  "bugs": {
    "url": "https://github.com/daniele-chiappa/plancia/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "window-manager",
    "tiling",
    "niri",
    "workspace",
    "components",
    "pinia",
    "sidebar",
    "dialog",
    "modal"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/plancia.js",
  "module": "./dist/plancia.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/plancia.js"
    },
    "./style.css": "./dist/plancia.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "prepublishOnly": "npm run build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "pinia": "^2.2.0 || ^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^25.0.1",
    "pinia": "^2.3.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.1.10"
  }
}
